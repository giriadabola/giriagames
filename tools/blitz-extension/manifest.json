{
  "manifest_version": 3,
  "name": "Bets Extracor",
  "version": "1.0",
  "description": "Extrai apostas do site blitz-high.bet e insere no painel do Árbitro.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://blitz-high.bet/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.web.app/*",
    "https://*.firebaseapp.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://blitz-high.bet/*"
      ],
      "js": ["content-blitz.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "http://localhost/*/admin/arbitro.html*",
        "http://127.0.0.1/*/admin/arbitro.html*",
        "https://*.web.app/admin/arbitro.html*",
        "https://*.firebaseapp.com/admin/arbitro.html*",
        "file:///*/admin/arbitro.html*"
      ],
      "js": ["content-arbitro.js"],
      "run_at": "document_end"
    }
  ]
}
