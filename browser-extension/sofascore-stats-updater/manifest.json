{
  "manifest_version": 3,
  "name": "GiriaGames - Atualizador de Estatísticas Sofascore (25/26)",
  "version": "1.0.0",
  "description": "Atualiza apenas o campo Estatísticas no modal de edição do GiriaGames (admin/editar-jogadores.html) a partir do Sofascore para a época 25/26.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.sofascore.com/*",
    "https://www.google.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/admin/editar-jogadores.html*", "*://localhost/*/admin/editar-jogadores.html*", "*://127.0.0.1/*/admin/editar-jogadores.html*"],
      "js": ["content-admin.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://www.google.com/search*"],
      "js": ["content-google.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.sofascore.com/*/player/*/*",
        "https://www.sofascore.com/player/*/*",
        "https://www.sofascore.com/*/jogador/*/*",
        "https://www.sofascore.com/jogador/*/*"
      ],
      "js": ["content-sofascore.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Atualizar Estatísticas Sofascore (25/26)"
  }
}
